     1	import { NextResponse } from "next/server";
     2	import { getEnv } from "@/lib/env";
     3	import { supabaseAdmin, DOCUMENTS_BUCKET } from "@/lib/db";
     4	
     5	export const maxDuration = 10;
     6	
     7	const VERSION = process.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7) ?? "dev";
     8	
     9	export async function GET() {
    10	  let env;
    11	  try {
    12	    env = getEnv();
    13	  } catch {
    14	    // Never echo the validation error: it lists which vars are missing, which
    15	    // is useful in logs but not something to expose over an unauthenticated route.
    16	    return NextResponse.json(
    17	      { ok: false, provider: null, db: "error", storage: "error", version: VERSION },
    18	      { status: 503 }
    19	    );
    20	  }
    21	
    22	  let db: "ok" | "error" = "error";
    23	  let storage: "ok" | "error" = "error";
    24	  try {
    25	    const client = supabaseAdmin();
    26	    const { error: dbError } = await client.from("regulations").select("id").limit(1);
    27	    db = dbError ? "error" : "ok";
    28	
    29	    const { error: storageError } = await client.storage.from(DOCUMENTS_BUCKET).list("", { limit: 1 });
    30	    storage = storageError ? "error" : "ok";
    31	  } catch {
    32	    // leave db/storage as "error"
    33	  }
    34	
    35	  const ok = db === "ok" && storage === "ok";
    36	  return NextResponse.json({ ok, provider: env.LLM_PROVIDER, db, storage, version: VERSION }, { status: ok ? 200 : 503 });
    37	}
