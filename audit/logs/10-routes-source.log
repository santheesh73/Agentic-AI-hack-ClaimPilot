    10	export const maxDuration = 60;
    11	
    12	const SAMPLES: Record<string, { title: string; insurer: string; claim_amount_inr: number; letter: string }> = {
    13	  a: {
    14	    title: "Sample Case A — PED waiting period already expired",
    15	    insurer: "United General Health Insurance Co. Ltd.",
    16	    claim_amount_inr: 185000,
    17	    letter: "letter_a.txt",
    18	  },
    19	  b: {
    20	    title: "Sample Case B — Non-disclosure, diagnosis date unknown",
    21	    insurer: "United General Health Insurance Co. Ltd.",
    22	    claim_amount_inr: 92500,
    23	    letter: "letter_b.txt",
    24	  },
    25	  c: {
    26	    title: "Sample Case C — Cosmetic surgery, explicit exclusion",
    27	    insurer: "United General Health Insurance Co. Ltd.",
    28	    claim_amount_inr: 110000,
    29	    letter: "letter_c.txt",
    30	  },
    31	};
    32	
    33	export async function POST(req: NextRequest) {
    34	  try {
    35	    const { sample } = await parseJsonBody(req, SampleBody);
    36	    const config = SAMPLES[sample];
    37	
    38	    const samplesDir = path.join(process.cwd(), "samples");
    39	    let policyBuffer: Buffer;
    40	    let letterText: string;
    41	    try {
    42	      [policyBuffer, letterText] = await Promise.all([
    43	        readFile(path.join(samplesDir, "policy.pdf")),
    44	        readFile(path.join(samplesDir, config.letter), "utf-8"),
    45	      ]);
    46	    } catch {
    47	      throw new ApiError(500, "samples_unavailable", "Sample files are not available on this deployment.");
    48	    }
    49	
    50	    const ownerId = await getOrCreateOwnerId();
    51	    await enforceRateLimit(ownerId, "newCase");
    52	    const db = supabaseAdmin();
    53	
    54	    const { data: caseRow, error: caseError } = await db
    55	      .from("cases")
    56	      .insert({ owner_id: ownerId, title: config.title, insurer: config.insurer, claim_amount_inr: config.claim_amount_inr, state: "INTAKE" })
    57	      .select("id")
    58	      .single();
    59	    if (caseError) throw caseError;
    60	    const caseId = caseRow.id as string;
    61	
    62	    const policyPages = await parsePdf(policyBuffer);
    63	    const { data: policyDoc, error: policyDocError } = await db
    64	      .from("documents")
    65	      .insert({ case_id: caseId, kind: "policy", filename: "policy.pdf", page_count: policyPages.length })
    66	      .select("id")
    67	      .single();
    68	    if (policyDocError) throw policyDocError;
    69	
    70	    const { error: policyPagesError } = await db.from("pages").insert(
    71	      policyPages.map((p) => ({ document_id: policyDoc.id, case_id: caseId, page_no: p.page_no, text: p.text, text_norm: p.text_norm }))
    72	    );
    73	    if (policyPagesError) throw policyPagesError;
    74	
    75	    const { data: rejectionDoc, error: rejectionDocError } = await db
    76	      .from("documents")
    77	      .insert({ case_id: caseId, kind: "rejection", filename: config.letter, page_count: 1 })
    78	      .select("id")
    79	      .single();
    80	    if (rejectionDocError) throw rejectionDocError;
    81	
    82	    const { error: rejectionPageError } = await db.from("pages").insert([
    83	      { document_id: rejectionDoc.id, case_id: caseId, page_no: 1, text: letterText, text_norm: normalize(letterText) },
    84	    ]);
    85	    if (rejectionPageError) throw rejectionPageError;
    86	
