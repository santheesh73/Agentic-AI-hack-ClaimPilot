# Supabase project URL (Project Settings > API > Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service_role secret key (Project Settings > API). Server-only --
# never exposed to the client despite the NEXT_PUBLIC_ var above being public.
SUPABASE_SERVICE_ROLE_KEY=

# Which model provider the agent uses. "google" is the default because that is
# the provider with a working key in this deployment; "anthropic" is fully
# implemented (including ephemeral prompt caching) but untested here for lack
# of a key. One or the other API key below is required depending on this value.
LLM_PROVIDER=google

# Required if LLM_PROVIDER=google. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required if LLM_PROVIDER=anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model ids for the two tiers the agent uses (fast: extraction/routing/short
# explanations; strong: assessment/drafting/red-teaming). Which model names are
# actually callable depends on your API key/project tier and changes over time
# -- see docs/ARCHITECTURE.md. Defaults if unset: claude-haiku-5-5/
# claude-sonnet-5-5 for anthropic, gemini-3.5-flash-lite for both under google.
MODEL_FAST=
MODEL_STRONG=

# Per-case cap on total LLM tokens (input + output, summed from agent_events).
# When a case reaches it, the next /step sets ERROR with a clear message
# instead of spending more. Unset = 60000 (the default); 0 = no cap.
MAX_TOKENS_PER_CASE=

# Global cap on model-spending requests (/step and /simulate) per UTC day,
# across all users, so one client can't exhaust the shared API quota.
# Unset = 1500.
GLOBAL_DAILY_LLM_CALLS=
